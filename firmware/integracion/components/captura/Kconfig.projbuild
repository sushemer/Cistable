menu "Cistable physical capture"
config CI_BENCH_50HZ
    bool "50 Hz bench profile (otherwise request 100 Hz)"
    default n
config CI_FULL_CAPTURE
    bool "Full binary application capture on console UART"
    depends on ESP_CONSOLE_UART_BAUDRATE >= 921600
    default n
    help
        Requires a PC binary recorder at 921600 baud, 8N1. Do not use a text
        monitor to save this stream. Callback/control producers never wait.
        Queue overflow and missing capture IDs invalidate completeness.
endmenu
